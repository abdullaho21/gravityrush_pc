# SPDX-License-Identifier: GPL-2.0-or-later
# Build environment of the Linux release (packaging/linux/build-release.sh uses it).
#
# The release has to start on systems older than the one it is built on (issue #1), so it is
# built on Ubuntu 24.04: its glibc 2.39 is the oldest the release then supports (SteamOS 3.7/3.8
# and Debian 13 have 2.41). The libraries a player's system cannot be expected to have in the
# right version are built here at fixed commits and copied into the package by
# packaging/linux/portable.py: SDL3 and FFmpeg as shared libraries (both binaries use them),
# fmt and Zydis as static ones.
FROM docker.io/library/ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates git python3 gcc-14 g++-14 make cmake ninja-build pkg-config nasm patchelf binutils \
        glslang-tools libvulkan-dev libboost-dev libfreetype-dev libx11-dev zlib1g-dev libxxhash-dev \
        libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev libxss-dev libxtst-dev \
        libxkbcommon-dev libwayland-dev libwayland-bin wayland-protocols libdecor-0-dev libdrm-dev libgbm-dev \
        libegl-dev libgl-dev libgles-dev libasound2-dev libpulse-dev libpipewire-0.3-dev libudev-dev \
        libdbus-1-dev libibus-1.0-dev libusb-1.0-0-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/gcc-14 /usr/local/bin/cc && ln -s /usr/bin/gcc-14 /usr/local/bin/gcc \
    && ln -s /usr/bin/g++-14 /usr/local/bin/c++ && ln -s /usr/bin/g++-14 /usr/local/bin/g++ \
    && git config --system --add safe.directory '*'
ENV CC=gcc-14 CXX=g++-14

# fetch NAME URL TAG COMMIT: the tag's source in /deps/NAME, refused if the tag moved; the
# version and license files are kept for the package (THIRD-PARTY-LICENSES).
RUN mkdir -p /deps /usr/local/share/gravityrush-licenses && printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    'git clone -q --depth 1 -c advice.detachedHead=false -b "$3" "$2" "/deps/$1"' \
    'got=$(git -C "/deps/$1" rev-parse HEAD)' \
    '[ "$got" = "$4" ] || { echo "$1: tag $3 is commit $got, expected $4" >&2; exit 1; }' \
    'echo "$1 $3 ($2, commit $4)" >> /usr/local/share/gravityrush-licenses/VERSIONS' \
    'for file in "/deps/$1"/LICENSE* "/deps/$1"/COPYING*; do' \
    '    [ -f "$file" ] && cp "$file" "/usr/local/share/gravityrush-licenses/$1-$(basename "$file")"' \
    'done' \
    'exit 0' > /usr/local/bin/fetch && chmod +x /usr/local/bin/fetch

# Headers only: Vulkan (newer than Ubuntu's; the loader comes from the player's system), Vulkan
# Memory Allocator, robin-map.
RUN fetch vulkan-headers https://github.com/KhronosGroup/Vulkan-Headers v1.4.363 6802bb4733b63ed5efd3adb308a6c885ef180ea1 \
    && fetch vma https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator v3.3.0 1d8f600fd424278486eade7ed3e877c99f0846b1 \
    && fetch robin-map https://github.com/Tessil/robin-map v1.4.1 bd14e6830a1474fed9d2d03f5c3b0683d818d540 \
    && for name in vulkan-headers vma robin-map; do \
           cmake -S /deps/$name -B /deps/$name/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local >/dev/null \
           && cmake --install /deps/$name/build >/dev/null || exit 1; \
       done && rm -rf /deps/*

# Static, linked into libgow3gpu.so.
RUN fetch fmt https://github.com/fmtlib/fmt 12.2.0 1be298e1bd68957e4cd352e1f676f00e07dcfb57 \
    && fetch zycore https://github.com/zyantific/zycore-c v1.5.2 0b2432ced0884fd152b471d97ecf0258ff4d859f \
    && fetch zydis https://github.com/zyantific/zydis v4.1.1 a2278f1d254e492f6a6b39f6cb5d1f5d515659dc \
    && static="-G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON" \
    && cmake -S /deps/fmt -B /deps/fmt/build $static -DFMT_TEST=OFF -DFMT_DOC=OFF >/dev/null \
    && cmake --build /deps/fmt/build && cmake --install /deps/fmt/build >/dev/null \
    && cmake -S /deps/zycore -B /deps/zycore/build $static >/dev/null \
    && cmake --build /deps/zycore/build && cmake --install /deps/zycore/build >/dev/null \
    && cmake -S /deps/zydis -B /deps/zydis/build $static -DZYAN_SYSTEM_ZYCORE=ON -DZYDIS_BUILD_TOOLS=OFF \
           -DZYDIS_BUILD_EXAMPLES=OFF -DZYDIS_BUILD_DOXYGEN=OFF >/dev/null \
    && cmake --build /deps/zydis/build && cmake --install /deps/zydis/build >/dev/null \
    && rm -rf /deps/*

# SDL3, shared. It opens the system's X11, Wayland, PipeWire, PulseAudio and udev libraries at
# run time (dlopen), so it does not depend on their versions.
RUN fetch sdl3 https://github.com/libsdl-org/SDL release-3.4.20 f00dc919ca35b9756316e86c4777392de442f9b2 \
    && cmake -S /deps/sdl3 -B /deps/sdl3/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
           -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TEST_LIBRARY=OFF -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF >/dev/null \
    && cmake --build /deps/sdl3/build && cmake --install /deps/sdl3/build >/dev/null \
    && rm -rf /deps/*

# FFmpeg, shared: its own decoders, demuxers and parsers only (LGPL; no external codec libraries,
# no encoders, muxers, devices, filters, network or programs). zlib is for the PNG decoder.
RUN fetch ffmpeg https://github.com/FFmpeg/FFmpeg n9.0.2 946fcce07b6dcd0331c8cc609192aeff5e1924f8 \
    && cd /deps/ffmpeg \
    && ./configure --prefix=/usr/local --cc=gcc-14 --enable-shared --disable-static --enable-pic \
           --disable-autodetect --enable-zlib --disable-programs --disable-doc --disable-debug \
           --disable-avdevice --disable-avfilter --disable-network --disable-encoders --disable-muxers \
           --disable-devices --disable-filters >/dev/null \
    && make -j"$(nproc)" >/dev/null && make install >/dev/null \
    && grep -E '^(FFMPEG_CONFIGURATION|#define FFMPEG_CONFIGURATION)' config.h \
           | sed 's/^#define FFMPEG_CONFIGURATION/ffmpeg configured with:/' >> /usr/local/share/gravityrush-licenses/VERSIONS \
    && cd / && rm -rf /deps/* && ldconfig

# Ubuntu's own packages that end up in the release: xxHash (shared, bundled) and Boost (headers).
RUN cp /usr/share/doc/libxxhash0/copyright /usr/local/share/gravityrush-licenses/xxhash-copyright \
    && awk '/^License: BSL-1.0$/ { text = ""; on = 1; next } on && /^$/ { on = 0 } on { text = text $0 "\n" } END { printf "%s", text }' \
           /usr/share/doc/libboost1.83-dev/copyright | sed 's/^ \.$//; s/^ //' > /usr/local/share/gravityrush-licenses/boost-LICENSE_1_0.txt \
    && grep -q 'Boost Software License - Version 1.0' /usr/local/share/gravityrush-licenses/boost-LICENSE_1_0.txt \
    && dpkg-query -W -f 'xxhash ${Version} (Ubuntu 24.04 package libxxhash0)\n' libxxhash0 >> /usr/local/share/gravityrush-licenses/VERSIONS \
    && dpkg-query -W -f 'boost ${Version} (Ubuntu 24.04 package libboost1.83-dev, headers)\n' libboost1.83-dev >> /usr/local/share/gravityrush-licenses/VERSIONS

# build.sh and package.sh read these (see packaging/linux/build-release.sh).
ENV GOW3_RELEASE=1 GOW3_STATIC_CXX=ON GOW3_BUNDLED_LICENSES=/usr/local/share/gravityrush-licenses
WORKDIR /src
